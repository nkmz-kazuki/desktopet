{
  "name": "desktopet",
  "version": "1.2.0",
  "description": "Desktopet · Windows 桌面陪伴",
  "main": "src/main.js",
  "author": "nkmz-kazuki",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test tests/*.test.js",
    "test:window": "node scripts/verify-window-layer.cjs",
    "test:models:live": "node scripts/verify-model-api.cjs",
    "build:icon": "node scripts/build-icon.cjs",
    "verify:package": "node scripts/verify-package.cjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.desktopet.companion",
    "productName": "Desktopet",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Desktopet-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "guid": "496f606a-f528-510c-99ab-760e03aab31d",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Desktopet"
    }
  }
}
